# Database configuration (optional, can be set via API)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database
DB_USER=root
DB_PASSWORD=your_password

# Ollama configuration (optional, can be set via API)
