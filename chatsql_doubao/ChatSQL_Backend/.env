# ChatSQL Backend 环境变量配置

# 应用配置
APP_NAME=ChatSQL_Backend
APP_VERSION=1.0.0
DEBUG=false

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS 配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=1000

# 向量数据库配置
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=database_metadata

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=chatsql.log